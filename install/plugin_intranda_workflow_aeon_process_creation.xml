<!-- this is all just examplary data: works only with RestTest.java as rest api -->

<config_plugin>

   <aeon>
       <url>https://example.com/api</url>
       <apiKey>1234567890</apiKey>
       <username>username</username>
       <password>password</password>
   </aeon>

  <processCreation>
    <batchDocstruct>BatchObject</batchDocstruct>
    <!-- Title of the created process. Fixed text, with placeholders in braces naming a <transaction>
         or <properties> field below by its <title>. A placeholder stands for the value the field holds
         when the processes are created, so it also picks up what the operator typed into the field.
         Characters Goobi does not allow in a process title are replaced by an underscore in these
         values; the fixed text is kept as written.
         If a referenced field is empty, nothing is created and the empty fields are named. A property
         field that does not apply to the material type of the request counts as empty.
         The fixed '_group' at the end marks the process as one that will be split into child
         processes; the stripParentSuffix of the split processes plugin must remove exactly that.
         Required. Replaces the earlier <batchTitleSuffix>, which is now rejected. -->
    <processTitle>{Transaction Identifier}_{Home site}_group</processTitle>
    <!-- Legacy option: true offers a choice between the batch creation above and the creation of one
         process per record, titled <processTitle>_0001, <processTitle>_0002, ... in the order of the
         selected records. These numbers repeat in every request, so the titles are only unique if
         <processTitle> contains the transaction identifier; a title already in use stops the request
         before anything is created. Absent or false hides that choice and always creates a batch process.
    <allowMultiProcessCreation>false</allowMultiProcessCreation> -->
    <!-- Metadata field on each child structure element that receives the record key: the transaction
         identifier followed by the position of the record among the selected ones, e.g. 286670_0001.
         The properties of that record are named with the same key, e.g. 286670_0001_Bib ID. It is the
         key the split processes plugin matches this child's properties on, so it must name the field of
         that plugin's <copyProperties prefix="metadata">. The metadata type must exist in the ruleset
         and be allowed on the child docstruct types. -->
    <childKeyMetadata>_OrderNumber</childKeyMetadata>
    <defaultWorkflowName>Paper workflow</defaultWorkflowName>
    <workflowName type="Audio Recording (DRMS)">Audio files</workflowName>
    <opacName>Metadata cloud</opacName>

    <!-- Name of the aeon field holding the material type. Its value is matched against the 'type' attribute
    of the <properties> fields below and therefore decides which properties are displayed and required.
    Empty by default, because aeon no longer delivers a material type: no field restricted to one applies
    then, the created processes carry the unrestricted properties alone, and nothing is reported. That is
    the intended setup rather than a fault. Configure this only where aeon does deliver a material type;
    a field named here but left blank by aeon is reported as a notice and the request continues.
    A slash separated path addresses a field inside a nested map. Older aeon versions kept the material type
    in the flat field shippingOption, which would be configured as:
    <materialTypeField>shippingOption</materialTypeField> -->

    <!-- Name of the aeon field holding the transaction number. A request without one is rejected, as
    it could not be recognised when it is sent a second time. Default: transactionNumber
    <transactionNumberField>transactionNumber</transactionNumberField> -->

    <!-- Name of the aeon field holding the patron user name, used to look up last name and mail
    address at the aeon Users endpoint. Default: username
    <usernameField>username</usernameField> -->

    <!-- Name of the aeon field holding the barcode that the catalogue is queried with.
    Default: referenceNumber
    <referenceNumberField>referenceNumber</referenceNumberField> -->
  </processCreation>


  <processCancellation>
    <transactionFieldName>TransactionIdentifier</transactionFieldName>
    <!-- unused at the moment
    <propertyName>Cancellation allowed</propertyName>
    <propertyValue>yes</propertyValue>
-->
    <!-- when this step is finished, cancellation is not allowed any more -->
    <stepName>Edition</stepName>
    <!-- if the user has this right, cancellation is still possible even if the step is finished -->
    <specialRights>aeon_allow_disable</specialRights>
    <projectName>Disabled_Project</projectName>
  </processCancellation>

