<!-- this is all just examplary data: works only with RestTest.java as rest api -->

<config_plugin>

   <aeon>
       <url>https://example.com/api</url>
       <apiKey>1234567890</apiKey>
       <username>username</username>
       <password>password</password>
   </aeon>

  <processCreation>
    <batchDocstruct>BatchObject</batchDocstruct>
    <!-- Optional suffix appended to the title of a batch process, marking it as one that will be
         split into child processes. The split processes plugin strips it again when it derives
         the child titles, so the strip attribute of its {parent} title part and this value
         must agree.
         Absent or empty leaves the batch title unchanged. -->
    <batchTitleSuffix>_group</batchTitleSuffix>
    <!-- Metadata field on each child structure element that receives the order number. It is the key
         the split processes plugin matches this child's properties on, and it must name the same
         field as that plugin's childKeyMetadata. The metadata type must exist in the ruleset and be
         allowed on the child docstruct types. -->
    <childKeyMetadata>_OrderNumber</childKeyMetadata>
    <defaultWorkflowName>Paper workflow</defaultWorkflowName>
    <workflowName type="Audio Recording (DRMS)">Audio files</workflowName>
    <opacName>Metadata cloud</opacName>

    <!-- Name of the aeon field holding the material type. Its value is matched against the 'type' attribute
    of the <properties> fields below and therefore decides which properties are displayed and required.
    Empty by default, because aeon no longer delivers a material type: no field restricted to one applies
    then, the created processes carry the unrestricted properties alone, and nothing is reported. That is
    the intended setup rather than a fault. Configure this only where aeon does deliver a material type;
    a field named here but left blank by aeon is reported as a notice and the request continues.
    A slash separated path addresses a field inside a nested map. Older aeon versions kept the material type
    in the flat field shippingOption, which would be configured as:
    <materialTypeField>shippingOption</materialTypeField> -->

    <!-- Name of the aeon field holding the home site. Its value becomes the repository part of the
    generated process title. Default: customFieldValues/HomeSite
    Older aeon versions kept it in the flat field itemInfo2:
    <homeSiteField>itemInfo2</homeSiteField> -->

    <!-- Name of the aeon field holding the transaction number. Its value opens the generated process
    title. Default: transactionNumber
    <transactionNumberField>transactionNumber</transactionNumberField> -->

    <!-- Name of the aeon field holding the patron user name, used to look up last name and mail
    address at the aeon Users endpoint. Default: username
    <usernameField>username</usernameField> -->

    <!-- Name of the aeon field holding the barcode that the catalogue is queried with.
    Default: referenceNumber
    <referenceNumberField>referenceNumber</referenceNumberField> -->
  </processCreation>


  <processCancellation>
    <transactionFieldName>TransactionIdentifier</transactionFieldName>
    <!-- unused at the moment
    <propertyName>Cancellation allowed</propertyName>
    <propertyValue>yes</propertyValue>
-->
    <!-- when this step is finished, cancellation is not allowed any more -->
    <stepName>Edition</stepName>
    <!-- if the user has this right, cancellation is still possible even if the step is finished -->
    <specialRights>aeon_allow_disable</specialRights>
    <projectName>Disabled_Project</projectName>
  </processCancellation>

  <requiredFields>
    <field>customFieldValues/HomeSite</field>
    <field>transactionNumber</field>
    <field>creationDate</field>
    <field>callNumber</field>
    <field>itemTitle</field>
    <field>referenceNumber</field>
    <field>location</field>
  </requiredFields>


  <!-- the transmission details are configured here;
  the values here are stored for all created processes;

  aeon = JSON path to the aeon response field this value comes from; a slash separated path
  addresses a field inside a nested map.

  variable/@place decides where the value is stored:
    place="process"  - a Goobi process property, as before. The variable is the property name.
    place="metadata" - a metadatum in the mets file. The variable is a metadata type name that the
                       ruleset of the workflow has to define, and that has to be allowed on the
                       docstruct the record is imported as. Process creation stops with an error
                       when either is missing.
  The default is "process", so a configuration written before metadata support existed keeps
  working unchanged.

  Values written as metadata are exported with the mets file. Do not configure patron names or
  other personal data as metadata. -->
  <transaction>
    <field aeon="transactionNumber">
      <title>Transaction Identifier</title>
      <type readonly="true">input</type>
      <variable place="metadata">TransactionIdentifier</variable>
      <value></value>
      <help>This is my description for the field so that everyone gets some help.</help>
      <validation strict="true">\d+</validation>
      <message>Your content does not follow our validation guidelines</message>
    </field>
