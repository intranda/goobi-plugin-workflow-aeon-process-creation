  <!-- the transmission details are configured here;
  the values here are stored for all created processes;

  aeon = JSON path to the aeon response field this value comes from; a slash separated path
  addresses a field inside a nested map.

  variable/@place decides where the value is stored:
    place="process"  - a Goobi process property, as before. The variable is the property name.
    place="metadata" - a metadatum in the mets file. The variable is a metadata type name that the
                       ruleset of the workflow has to define, and that has to be allowed on the
                       docstruct the record is imported as. Process creation stops with an error
                       when either is missing.
  The default is "process", so a configuration written before metadata support existed keeps
  working unchanged.

  Values written as metadata are exported with the mets file. Do not configure patron names or
  other personal data as metadata. -->
  <transaction>
    <field aeon="transactionNumber">
      <title>Transaction Identifier</title>
      <type readonly="true">input</type>
      <variable place="metadata">TransactionIdentifier</variable>
      <value></value>
      <help>This is my description for the field so that everyone gets some help.</help>
      <validation strict="true">\d+</validation>
      <message>Your content does not follow our validation guidelines</message>
    </field>
    <!-- Part of the process title above. Editable, because aeon does not always deliver a home site,
    and an empty one stops the request until the operator fills it in. -->
    <field aeon="customFieldValues/HomeSite">
      <title>Home site</title>
      <type>input</type>
      <variable place="process">Home site</variable>
      <value></value>
      <help>Repository the request belongs to. Part of the process title.</help>
    </field>
